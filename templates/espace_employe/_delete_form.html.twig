<form method="post" action="{{ path('userEmploye.delete', {'id': user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce compte ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="btn btn-danger rounded-2 fs-2 me-2">Supprimer</button>
</form>
