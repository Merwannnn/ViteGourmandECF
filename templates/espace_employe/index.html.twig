{% extends 'base.html.twig' %}

{% block title %}
    {% if is_granted('ROLE_ADMIN') %}
        Espace administrateur
    {% else %}
        Espace employé
    {% endif %}
{% endblock %}

{% block header %}
    {% if is_granted('ROLE_ADMIN') %}
        <header class="mt-auto top-0 start-0 end-0 text-center py-2 ms-4 div-pres">
            <div class="container-fluid">
                <p>Administrateur</p>
            </div>
        </header>
    {% else %}
        <header class="mt-auto top-0 start-0 end-0 text-center py-2 ms-4 div-pres">
            <div class="container-fluid">
                <p>Employé</p>
            </div>
        </header>
    {% endif %}
{% endblock %}

{% block body %}
{% if is_granted('ROLE_ADMIN') %}
<div class="border bg-custom-pink rounded p-2 mb-4">
    <div class="titleFontSize fw-semibold text-center">Statistiques</div>
    <div class="bg-custom-black-pink border rounded p-2">
        <a href="{{ path('chiffre_affaire_menu.show') }}" class="btn border bg-custom-pink fs-4 p-2 m-2 d-flex justify-content-center">Chiffre d'affaire par menu</a>
        <a href="{{ path('commandes.stats') }}" class="btn border bg-custom-pink fs-4 p-2 m-2 d-flex justify-content-center">Nombres de commandes par menu</a>
    </div>
</div>
{% endif %}
{% if is_granted('ROLE_ADMIN') %}
<div class="border bg-custom-pink rounded p-2 mb-4">
    <div class="titleFontSize fw-semibold text-center">Comptes-employés</div>
    <div class="bg-custom-black-pink border rounded p-2">
        <a href="{{ path('espace_employe.indexComptes') }}" class="btn border bg-custom-pink fs-4 p-2 m-2 d-flex justify-content-center">Gestion des comptes</a>
    </div>
</div>
{% endif %}
<div class="border bg-custom-pink rounded p-2 mb-4">
    <div class="titleFontSize fw-semibold text-center">Commandes</div>
    <div class="bg-custom-black-pink border rounded p-2">
        <a href="{{ path('commande.index') }}" class="btn border bg-custom-pink fs-4 p-2 m-2 d-flex justify-content-center">Gestion des commandes</a>
        {{ form_start(form, { method: 'get' }) }}
            {{ form_row(form.username) }}
            {{ form_row(form.statut) }}
            <button type="submit" class="btn btn-secondary">Appliquer</button>
        {{ form_end(form) }}
    </div>
</div>
<div class="border bg-custom-pink rounded p-2 mb-4">
    <div class="titleFontSize fw-semibold text-center">Menus</div>
    <div class="bg-custom-black-pink border rounded p-2">
        <a href="{{ path('menu.index') }}" class="btn border bg-custom-pink fs-4 p-2 m-2 d-flex justify-content-center">Gestion des menus</a>
    </div>
</div>
<div class="border bg-custom-pink rounded p-2 mb-4">
    <div class="titleFontSize fw-semibold text-center">Plats</div>
    <div class="bg-custom-black-pink border rounded p-2">
        <a href="{{ path('plat.index') }}" class="btn border bg-custom-pink fs-4 p-2 m-2 d-flex justify-content-center">Gestion des plats</a>
    </div>
</div>
<div class="border bg-custom-pink rounded p-2 mb-4">
    <div class="titleFontSize fw-semibold text-center">Avis</div>
    <div class="bg-custom-black-pink border rounded p-2">
        <a href="{{ path('avis.index') }}" class="btn border bg-custom-pink fs-4 p-2 m-2 d-flex justify-content-center">Gestion des avis</a>
    </div>
</div>
<div class="border bg-custom-pink rounded p-2 mb-4">
    <div class="titleFontSize fw-semibold text-center">Horaires</div>
    <div class="bg-custom-black-pink border rounded p-2">
        <a href="{{ path('horaire.index') }}" class="btn border bg-custom-pink fs-4 p-2 m-2 d-flex justify-content-center">Gestion des horaire</a>
    </div>
</div>
{% endblock %}
