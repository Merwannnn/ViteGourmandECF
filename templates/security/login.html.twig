{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block header %}
    <header class="mt-auto top-0 start-0 end-0 text-center py-2 ms-4 div-pres">
        <div class="container-fluid">
            <p>Connexion</p>
        </div>
    </header>
{% endblock %}

{% block body %}
<div class="flex-fill d-flex align-items-center justify-content-center">
    <form method="post">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <label for="username" class="fs-2">Email</label>
        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
        <label for="password" class="fs-2">Mot de passe</label>
        <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <p class="fs-2">Vous avez oubliez votre mot de passe, <a href="{{ path('app_forgot_password_request') }}">Reinitialiser le ici !</a></p>

        <div class="checkbox mb-3">
            <input type="checkbox" name="_remember_me" id="_remember_me">
            <label for="_remember_me" class="fs-2">Se souvenir de moi</label>
        </div>

        <button class="btn btn-lg btn-primary fs-2" type="submit">
            Connexion
        </button>

        <div>
            <p class="fs-2">Vous n'avez pas de compte, <a href="{{ path('app_register') }}">Créez-en un!</a></p>
        </div>
    </form>
</div>
{% endblock %}
