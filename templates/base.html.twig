<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <link href="{{ asset('css/custom-color.css') }}" rel="stylesheet">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <nav class="navbar bg-custom-pink navbar-expand-lg" style="z-index:1040;" data-bs-theme="dark">
            <div class="container-fluid py-2">
                <a class="navbar-brand px-1 bg-custom-pink shadow-inner-drop rounded-2 fs-2" href="{{ path('home') }}">Vite & Gourmand</a>
                <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav fs-3">
                            <li class="nav-item">
                                <a class="nav-link {{ app.current_route == 'menu.index' ? 'active' : '' }}" href="/menu">Menus</a>
                            </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.current_route == 'contact' ? 'active' : '' }}" href="/contact">Contact</a>
                        </li>
                        {% if is_granted('ROLE_EMPLOYE') or is_granted('ROLE_ADMIN') %} 
                        <li class="nav-item">
                            <a class="nav-link {{ app.current_route == 'espace_employe.index' ? 'active' : '' }}" href="/espace-employe">Mon Espace</a>
                        </li>
                        {% else %}
                        <li class="nav-item">
                            <a class="nav-link {{ app.current_route == 'espace.index' ? 'active' : '' }}" href="/mon-espace">Mon Espace</a>
                        </li>
                        {% endif %}
                        {% if is_granted('ROLE_USER') or is_granted('ROLE_EMPLOYE') or is_granted('ROLE_ADMIN') %}                    
                        <li class="nav-item">
                            <a class="nav-link {{ app.current_route == 'app_logout' ? 'active' : '' }}" href="/logout">Déconnexion</a>
                        </li>
                        {% else %}                    
                        <li class="nav-item">
                            <a class="nav-link {{ app.current_route == 'app_login' ? 'active' : '' }}" href="/login">Connexion</a>
                        </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
        {% block header %}{% endblock %}
        <div class="position-fixed top-0 start-0 vh-100 bg-custom-pink" style="width:44px; z-index:1030;"></div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js" integrity="sha384-k6d4wzSIapyDyv1kpU366/PK5hCdSbCRGRCMv+eplOQJWyd1fbcAu9OCUj5zNLiq" crossorigin="anonymous"></script>
        <div class="container pt-4 pb-4 d-flex flex-column min-vh-100" style="padding-left:44px;">
        {% include 'partials/flash.html.twig' %}
            {% block body %}{% endblock %}
        </div>
        {% block middle %}{% endblock %}
        {% block footer %}
        <footer class="mt-auto bottom-0 start-0 end-0 bg-dark text-white text-center py-2">
            <div class="container-fluid">
            {% for horaire in horaires.show %}
                <p>
                    {{ horaire.jour}}

                    {% if horaire.heureOuverture and horaire.heureFermeture %}
                        {{ horaire.heureOuverture|date('H:i') }}
                        {{ horaire.heureFermeture|date('H:i') }}
                    {% endif %}
                    
                    {% if horaire.exception %}
                        {{ horaire.exception }}
                    {% endif %}
                </p>
            {% endfor %}
            <p class="d-flex align-items-center justify-content-center">
                <a href="{{ path('conditions_generales') }}" class="fs-6 p-2 m-2 text-decoration-none link-light">Conditions générale de vente</a> |
                <a href="{{ path('mentions_legal') }}" class="fs-6 p-2 m-2 text-decoration-none link-light">Mention légales</a>
            </p>
            </div>
        </footer>
        {% endblock %}
    </body>
</html>
