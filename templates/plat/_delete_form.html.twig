<form method="post" action="{{ path('plat.delete', {'id': plat.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plat.id) }}">
    <button class="btn btn-danger rounded-2 fs-2 me-2">Supprimer</button>
</form>
