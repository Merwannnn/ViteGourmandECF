{% extends 'base.html.twig' %}

{% block title %}Menu disponible{% endblock %}

{% block header %}
    <header class="mt-auto top-0 start-0 end-0 text-center py-2 ms-4 div-pres">
        <div class="container-fluid">
            <p>Menus</p>
        </div>
    </header>
{% endblock %}

{% block body %}

<div class="border bg-custom-pink rounded p-2 mb-4">
    <div class="fs-1 fw-semibold text-center">Filtre</div>
    <div class="bg-custom-black-pink border rounded p-2">
    {# permet d'afficher et d'appliquer le formulaire de filtrage des menu via prix, theme, regime ou nombre de personne minimum #}
    {{ form_start(form, { method: 'get', attr: { id: 'form-filters' } }) }}
        {{ form_row(form.prixMax) }}
        {{ form_row(form.prixMin) }}
        {{ form_row(form.theme) }}
        {{ form_row(form.regime) }}
        {{ form_row(form.personneMin) }}
        <button type="button" id="btn-menu-filters" class="btn btn-secondary">Appliquer</button>
    {{ form_end(form) }}
    </div>
</div>

{# permet d'afficher ces bouton uniquement si l'utilisateur est administrateur #}
{% if is_granted('ROLE_ADMIN') %}
<div>
    <a href="{{ path('menu.create') }}" class="btn btn-danger fs-4 p-2 m-2">Créer un nouveau menu</a>
    <a href="{{ path('plat.create') }}" class="btn btn-secondary fs-4 p-2 m-2">Créer un nouveau plat</a>
</div>
{% endif %}

<div id="menu-container">
{% for menu in menus %}
    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}
    <div class="border bg-custom-pink rounded p-2 mb-1" id="">
    {% else %}
    <div class="border bg-custom-pink rounded p-2 mb-4">  
    {% endif %}
        <div class="fs-1 fw-semibold text-center">{{ menu.title }}</div>
        <div class="bg-custom-black-pink border rounded p-2">
            <div class="fs-3 pb-4">{{ menu.description }}</div>
            <div>
                <span class="fs-3 border bg-custom-pink rounded p-1">Nombre de personne minimum: {{ menu.nbPersonneMinimum }}</span><br><br>
                <span class="fs-3 border bg-custom-pink rounded p-1">Prix: {{ menu.prixPersonne }}€</span>
            </div>
            <div class="text-end">
                <a href="{{ path('menu.show', {'id': menu.id}) }}" class="btn bg-custom-pink shadow-inner-drop rounded-2 fs-2 me-2">Détails</a>
            </div>
        </div>
    </div>
    {# permet d'afficher ces bouton uniquement si l'utilisateur est administrateur ou employe #}
    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}
    <div class="text-end d-flex justify-content-between mb-4">
        <a href="{{ path('menu.edit', {'id': menu.id}) }}" class="btn btn-primary fs-4 p-2 m-2">Modifier</a>
        {{ include('menu/_delete_form.html.twig') }}
    </div>
    {% endif %}
{% else %}
<div colspan="8">Aucun menu disponible</div>
{% endfor %}
</div>
{# ce script permet de récuperer le javascript(menu_filtre.js) qui permet d'utiliser le formulaire de filtrage sans rechargement de page #}
<script src="{{ asset('js/menu_filtre.js') }}"></script>
{% endblock %}