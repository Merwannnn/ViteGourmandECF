{% extends 'base.html.twig' %}

{% block title %}Menu{% endblock %}

{% block body %}
<div class="border bg-custom-pink rounded p-2 mb-4">
        <div class="fs-1 fw-semibold">{{ menu.title }}</div>
        <div class="bg-custom-black-pink border rounded p-2">
            <div class="fs-3 pb-4">{{ menu.description }}</div>
            <ul class="flex-wrap border bg-light rounded d-flex justify-content-center list-unstyled p-1">
                {% for plat in menu.plat %}
                    <li class="px-3 mb-4 d-flex flex-column align-items-center">
                        <span class="text-custom-pink fs-1 fst-italic fw-bold">° {{ plat.platTitle }}</span>
                        <img src="{{ vich_uploader_asset(plat, 'thumbnailFile') }}" class="img-fluid thumbnailFile-img rounded">
                    </li>
                {% endfor %}
            </ul>
            <div>
                <span class="fs-3 border bg-custom-pink rounded p-1">Nombre de personne minimum: {{ menu.nbPersonneMinimum }}</span><br><br>
                <span class="fs-3 border bg-custom-pink rounded p-1">Thême du menu: {{ menu.theme.themeTitle }}</span><br><br>
                <span class="fs-3 border bg-custom-pink rounded p-1">Prix: {{ menu.prixPersonne }}€</span>
                <span class="fs-3 border bg-custom-pink rounded p-1">Régime: {{ menu.regime }}</span>
                <span class="fs-3 border bg-custom-pink rounded p-1">Quantité restante: {{ menu.quantiteRestante }}</span><br><br>
            </div>
            {% for plat in menu.plat %}
            <div>
                <span class="fs-3 border bg-custom-pink rounded p-1">Allergene: {{ plat.allergene }}</span><br><br>
            </div>
            {% endfor %}
            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}  

            {% else %}
            <div class="text-end">
                <a href="{{ path('commande.create', {'id': menu.id}) }}" class="btn btn-primary fs-4 p-2 m-2">Commander</a>
            </div>
            {% endif %}
        </div>
</div>
{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}  
<div class="text-end">
    <a href="{{ path('menu.edit', {'id': menu.id}) }}" class="btn btn-primary fs-4 p-2 m-2">Modifier</a>
</div>
{% endif %}

<a href="{{ path('menu.index') }}" class="btn border bg-custom-pink fs-4 p-2 m-2">Retour à la page précédente</a>

{% endblock %}
