<form method="post" action="{{ path('menu.delete', {'id': menu.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ menu.id) }}">
    <button class="btn btn-danger fs-4 p-2 m-2">Supprimer</button>
</form>
