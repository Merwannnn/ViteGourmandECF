<form method="post" action="{{ path('avis.delete', {'id': avi.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir refuser cet avis ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ avi.id) }}">
    <button class="btn btn-danger rounded-2 fs-2 me-2">Refuser</button>
</form>
