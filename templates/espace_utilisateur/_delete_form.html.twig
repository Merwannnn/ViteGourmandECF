<form method="post" action="{{ path('commande.delete', {'id': commande.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler votre commande ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commande.id) }}">
    <button class="btn btn-danger rounded-2 fs-2 me-2">Annuler</button>
</form>
