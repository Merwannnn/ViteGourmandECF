{% extends 'base.html.twig' %}

{% block title %}Mon espace{% endblock %}

{% block header %}
    <header class="mt-auto top-0 start-0 end-0 text-center py-2 ms-4 div-pres">
        <div class="container-fluid">
            <p>Mes Commandes</p>
        </div>
    </header>
{% endblock %}

{% block body %}
{% for commande in commandes %}
    <div class="border bg-custom-pink rounded p-2 mb-4">
        <div class="fs-1 fw-semibold">{{ commande.menu.title }} | {{ commande.numeroCommande }}</div>
        <div class="bg-custom-black-pink border rounded p-2">
            <div>
                <span class="fs-3 border bg-custom-pink rounded p-1">Date de la commande: {{ commande.dateCommande ? commande.dateCommande|date('Y-m-d') : '' }}</span>
                <span class="fs-3 border bg-custom-pink rounded p-1">Date de la préstation: {{ commande.datePrestation ? commande.datePrestation|date('Y-m-d') : '' }}</span>
                <span class="fs-3 border bg-custom-pink rounded p-1">Heure de livraison: {{ commande.heureLivraison ? commande.heureLivraison|date('H:i') : '' }}</span><br><br>
                <span class="fs-3 border bg-custom-pink rounded p-1">Nom client: {{ commande.user.name }}</span>
                <span class="fs-3 border bg-custom-pink rounded p-1">Email client: {{ commande.user.email }}</span>
                <span class="fs-3 border bg-custom-pink rounded p-1">Numéro de téléphone client: {{ commande.user.phone }}</span><br><br>
                <span class="fs-3 border bg-custom-pink rounded p-1">Adresse du client: {{ commande.adresseLivraison }}</span><br><br>
                <span class="fs-3 border bg-custom-pink rounded p-1">Prix du menu: {{ commande.prixMenu }}€</span>
                <span class="fs-3 border bg-custom-pink rounded p-1">Prix de la livraison: {{ commande.prixLivraison }}€</span><br><br>
                <span class="fs-3 border bg-custom-pink rounded p-1">Prêt de matériel: {{ commande.pretMateriel ? 'Oui' : 'Non' }}</span>
                <span class="fs-3 border bg-custom-pink rounded p-1">Réstitution du matériel: {{ commande.restitutionMateriel ? 'Oui' : 'Non'  }}</span>
                <span class="fs-3 border bg-custom-pink rounded p-1">Statut actuelle: {{ commande.statut }}</span><br><br>
                {% for status in commande.statutHistorique %}
                    <span class="fs-3 border bg-custom-pink rounded p-1">Historique des statuts: {{ status.statutSuivant }} - {{ status.updatedAt|date('Y-m-d H:i') }}</span><br><br>
                {% endfor %}

            </div>
            <div class="text-start">
            {# permet d'afficher le bouton pour laisser un avis sur une commande si la commande est terminée et si l'utilisateur connecté 
            est celui qui a passée commande et n'a pas déja laisser un avis #}
            {% if commande.statut == 'Terminée' %}
                {% if not commande.avis|filter(a => a.user == app.user)|length %}
                    <a href="{{ path('avis.create', {'id': commande.id}) }}" class="btn bg-custom-pink shadow-inner-drop rounded-2 fs-2">Laisser un avis</a>
                {% else %}
                    <p>Vous avez déja donner votre avis</p>
                {% endif %}
            {% endif %}
            </div>
            {# permet d'autoriser la modification d'une commande par un client uniquement si le statut de la commande est "Commande passée" #}
            {% if commande.statut == 'Commande passée' %}
                <div class="d-flex justify-content-end">
                    <a href="{{ path('commande.edit', {'id': commande.id}) }}" class="btn bg-custom-pink shadow-inner-drop rounded-2 fs-2 me-2">Modifier</a>
                    <p>{{ include('espace_utilisateur/_delete_form.html.twig') }}</p>
                </div>
            {% endif %}
        </div>
    </div>
{% else %}
<div colspan="8">Aucune commande disponible</div>
{% endfor %}
<nav class="pagination-wrapper d-flex justify-content-end" aria-label="Pagination">
    {{ knp_pagination_render(commandes) }}
</nav>
{% endblock %}