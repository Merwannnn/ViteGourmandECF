        Duis egestas eleifend eros, nec sagittis justo.
        </p>
    </div>
    <div class="container-fluid text-center py-2 rounded div-middle-bar">
        <p>Les Avis de nos Clients:</p>
    </div>
    <div id="carouselAvis" class="carousel slide py-4" data-bs-ride="carousel" data-bs-interval="4000">
        <div class="carousel-inner">
            {% for avi in avis %}
                {% if avi.statut == 'Validé' %}
                <div class="carousel-item {% if loop.first %}active{% endif %}" style="height:400px;">
                    <div class="d-flex align-items-center justify-content-center h-100">
                        <div class="card w-50 text-center">
                            <div class="card-header">Note: {{ avi.note }}</div>
                            <div class="card-body">
                                <div class="card-text">{{ avi.commentaire }}</div>
                            </div>
                        </div>
                    </div>
                </div>
                {% else %}
                    
                {% endif %}
            {% endfor %}
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselAvis" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselAvis" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
    </div>
</div>
{% endblock %}