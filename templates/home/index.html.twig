{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block header %}
<header class="mt-auto top-0 start-0 end-0 text-center py-2 ms-4 div-pres">
    <div class="container-fluid">
        <p>Nous sommes Vite & Gourmand</p>
    </div>
</header>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div id="carouselAccueil" class="carousel slide py-4" data-bs-ride="carousel" data-bs-interval="4000">
        <div class="carousel-inner gap-3">
            <div class="carousel-item active text-center">
                <img src="{{ asset('images/accueil/lapleiade-restaurant-5238976_1280.jpg') }}" class="img-fluid rounded"/>
            </div>
            <div class="carousel-item text-center">
                <img src="{{ asset('images/accueil/vitesca-big-kitchen-2765065_1280.jpg') }}" class="img-fluid rounded"/>
            </div>
            <div class="carousel-item text-center">
                <img src="{{ asset('images/accueil/jhfl-chunks-2854126_1280.jpg') }}" class="img-fluid rounded"/>
            </div>
            <div class="carousel-item text-center">
                <img src="{{ asset('images/accueil/caniceus-meal-8388203_1280.jpg') }}" class="img-fluid rounded"/>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselAccueil" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselAccueil" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
    <div class="container pb-4">
        <p class="fs-3 fw-semibold text-center">
            Vite & Gourmand est un traiteur bordelais qui existe depuis 25 ans, fondé par Julie et José Vite & Gourmand propose différents menus pour tout type d'évènement de plus les menus sont évolutif ce qui permet de profiter de différentes saveur si vous commander un même menu sur différentes périodes. 
            Nos employé sont formé pour tout faire pour que votre expérience de nos services soit irréprochable et vous accompagne tout du long de votre commande si vous souhaité des précisions, et même avant si vous souhaiter nous contacter via le formulaire pour demander des renseignements sur nos différents menus.
            Nous vous souhaitons la meilleur expérience possible chez Vite & Gourmand,
        </p>    
        <p class="fs-3 fw-semibold text-center">
            Bonne commande !!
        </p>
    </div>
    <div class="container-fluid text-center py-2 rounded div-middle-bar">
        <p>Les Avis de nos Clients:</p>
    </div>
    <div id="carouselAvis" class="carousel slide py-4" data-bs-ride="carousel" data-bs-interval="4000">
        <div class="carousel-inner">
            {% for avi in avis %}
                {% if avi.statut == 'Validé' %}
                <div class="carousel-item {% if loop.first %}active{% endif %}" style="height:400px;">
                    <div class="d-flex align-items-center justify-content-center h-100">
                        <div class="card w-50 text-center">
                            <div class="card-header bg-custom-pink">Note: {{ avi.note }}</div>
                            <div class="card-body">
                                <div class="card-text">{{ avi.commentaire }}</div>
                            </div>
                        </div>
                    </div>
                </div>
                {% else %}
                    
                {% endif %}
            {% endfor %}
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselAvis" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselAvis" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
    </div>
</div>
{% endblock %}